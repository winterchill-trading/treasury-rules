bug-reports: "https://github.com/winterchill-trading/treasury-rules/issues"
depends: [
  "oxcaml"
  "ocaml" {>= "5.2.0" & < "5.3~"}
  "dune" {>= "3.17"}
  "treasury-rules" {= version}
  "core" {>= "v0.18~preview.130.106+341" & < "v0.19~"}
  "core_unix" {>= "v0.18~preview.130.106+341" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~preview.130.106+341" & < "v0.19~"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
